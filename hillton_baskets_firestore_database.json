{
  "database_name": "hillton_baskets_firestore",
  "description": "Complete Firestore database structure for Hillton Baskets e-commerce platform",
  "version": "1.0.0",
  "last_updated": "2025-12-13",
  "collections": {
    "company_info": {
      "path": "company_info/{companyId}",
      "description": "Editable company information, policies, and social media links",
      "document_structure": {
        "companyId": "hillton_baskets_main",
        "companyName": "Hillton Baskets",
        "tagline": "Premium Modular Kitchen Solutions",
        "logo": {
          "url": "string (Firebase Storage URL)",
          "thumbnailURL": "string"
        },
        "contactInfo": {
          "email": "contact@hilltonbaskets.in",
          "phone": "+91 XXXXXXXXXX",
          "whatsapp": "+91 XXXXXXXXXX",
          "supportEmail": "support@hilltonbaskets.in"
        },
        "address": {
          "registeredOffice": "string",
          "line1": "string",
          "line2": "string",
          "city": "string",
          "state": "string",
          "pincode": "string",
          "country": "India",
          "gstNumber": "string"
        },
        "aboutUs": {
          "title": "About Hillton Baskets",
          "description": "string (long text)",
          "missionStatement": "string",
          "visionStatement": "string"
        },
        "ourStory": {
          "title": "Our Story",
          "content": "string (long text)",
          "foundedYear": "number",
          "founderNames": [
            "string"
          ]
        },
        "experiences": {
          "title": "Our Experience",
          "yearsInBusiness": "number",
          "projectsCompleted": "number",
          "happyCustomers": "number",
          "productsCatalog": "number",
          "milestones": [
            {
              "year": "number",
              "achievement": "string",
              "description": "string"
            }
          ]
        },
        "ourValues": {
          "title": "Our Values",
          "values": [
            {
              "name": "string",
              "description": "string",
              "icon": "string"
            }
          ]
        },
        "socialMedia": {
          "facebook": "string (URL)",
          "instagram": "string (URL)",
          "twitter": "string (URL)",
          "linkedin": "string (URL)",
          "youtube": "string (URL)",
          "pinterest": "string (URL)"
        },
        "policies": {
          "termsAndConditions": {
            "title": "Terms & Conditions",
            "content": "string (HTML/Markdown)",
            "lastUpdated": "timestamp",
            "version": "string"
          },
          "privacyPolicy": {
            "title": "Privacy Policy",
            "content": "string (HTML/Markdown)",
            "lastUpdated": "timestamp",
            "version": "string"
          },
          "refundAndCancellation": {
            "title": "Refund and Cancellation Policy",
            "content": "string (HTML/Markdown)",
            "cancellationWindowDays": 1,
            "refundProcessingDays": 7,
            "lastUpdated": "timestamp"
          },
          "returnPolicy": {
            "title": "Return Policy",
            "content": "string (HTML/Markdown)",
            "returnWindowDays": 3,
            "lastUpdated": "timestamp"
          },
          "shippingPolicy": {
            "title": "Shipping Policy",
            "content": "string (HTML/Markdown)",
            "shippingDays": 1,
            "lastUpdated": "timestamp"
          }
        },
        "operatingHours": {
          "monday": {
            "open": "09:00",
            "close": "18:00"
          },
          "tuesday": {
            "open": "09:00",
            "close": "18:00"
          },
          "wednesday": {
            "open": "09:00",
            "close": "18:00"
          },
          "thursday": {
            "open": "09:00",
            "close": "18:00"
          },
          "friday": {
            "open": "09:00",
            "close": "18:00"
          },
          "saturday": {
            "open": "09:00",
            "close": "18:00"
          },
          "sunday": {
            "open": "Closed",
            "close": "Closed"
          }
        },
        "legalInfo": {
          "companyRegistrationNumber": "string",
          "gstNumber": "string",
          "panNumber": "string"
        },
        "isActive": true,
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
