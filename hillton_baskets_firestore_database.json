    "users": {
      "path": "users/{userId}",
      "description": "Customer accounts with order history, addresses, wishlist",
      "document_structure": {
        "userId": "string (Firebase Auth UID)",
        "name": "string",
        "email": "string",
        "phone": "string",
        "photoURL": "string (Firebase Storage URL)",
        "role": "enum (customer | admin | support_agent)",
        "status": "enum (active | suspended | deactivated)",
        "preferences": {
          "notifications": {
            "orderUpdates": "boolean",
            "promotions": "boolean",
            "offers": "boolean",
            "whatsapp": "boolean"
          }
        },
        "walletBalance": "number",
        "loyaltyPoints": "number",
        "totalOrders": "number",
        "lastLogin": "timestamp",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "subcollections": {
        "addresses": {
          "path": "users/{userId}/addresses/{addressId}",
          "document_structure": {
            "addressId": "string (auto-generated)",
            "label": "enum (home | work | other)",
            "line1": "string",
            "line2": "string",
            "landmark": "string",
            "city": "string",
            "state": "string",
            "pincode": "string",
            "geoPoint": "GeoPoint",
            "contactName": "string",
            "contactPhone": "string",
            "isDefault": "boolean",
            "isActive": "boolean",
            "createdAt": "timestamp"
          }
        },
        "cart": {
          "path": "users/{userId}/cart/{cartId}",
          "document_structure": {
            "cartId": "string (auto-generated)",
            "status": "enum (active | checked_out | abandoned)",
            "totalAmount": "number",
            "itemCount": "number",
            "addedAt": "timestamp",
            "updatedAt": "timestamp",
            "appliedCoupon": {
              "couponId": "string (ref: coupons/{couponId})",
              "discountAmount": "number"
            }
          },
          "subcollections": {
            "cart_items": {
              "path": "users/{userId}/cart/{cartId}/cart_items/{itemId}",
              "document_structure": {
                "itemId": "string (auto-generated)",
                "productId": "string (ref: products/{productId})",
                "name": "string",
                "price": "number",
                "quantity": "number",
                "totalPrice": "number",
                "specifications": {
                  "size": "string",
                  "material": "string",
                  "finish": "string"
                },
                "imageURL": "string",
                "notes": "string",
                "addedAt": "timestamp"
              }
            }
          }
        },
        "wishlist": {
          "path": "users/{userId}/wishlist/{wishlistId}",
          "document_structure": {
            "wishlistId": "string (auto-generated)",
            "productId": "string (ref: products/{productId})",
            "addedAt": "timestamp",
            "price": "number"
          }
        },
        "notifications": {
          "path": "users/{userId}/notifications/{notificationId}",
          "document_structure": {
            "notificationId": "string (auto-generated)",
            "title": "string",
            "message": "string",
            "type": "enum (order | promotion | payment | general)",
            "relatedOrderId": "string (ref: orders/{orderId})",
            "imageURL": "string",
            "isRead": "boolean",
            "createdAt": "timestamp",
            "actionURL": "string"
          }
        }
      }
    },
    "products": {
      "path": "products/{productId}",
      "description": "Product catalog for kitchen baskets and accessories",
      "document_structure": {
        "productId": "string (auto-generated)",
        "sku": "string (unique, e.g., 'HB-8T-001')",
        "name": "string",
        "description": "string",
        "mainImageURL": "string",
        "galleryURLs": [
          "string"
        ],
        "category": "string (ref: categories/{categoryId})",
        "subCategory": "string",
        "specifications": {
          "size": "string (e.g., '8 Inch')",
          "material": "string (e.g., 'Stainless Steel')",
          "finish": "string (e.g., 'Chrome Plated')",
          "weight": "string (e.g., '2.5 kg')",
          "dimensions": {
            "length": "number (mm)",
            "width": "number (mm)",
            "height": "number (mm)"
          },
          "loadCapacity": "string (e.g., '15 kg')",
          "installation": "string"
        },
        "price": "number",
        "discountedPrice": "number",
        "mrp": "number",
        "tax": {
          "gstRate": "number",
          "hsnCode": "string"
        },
        "inventory": {
          "currentStock": "number",
          "reorderLevel": "number",
          "maxStockLevel": "number"
        },
        "isAvailable": "boolean",
        "isFeatured": "boolean",
        "tags": [
          "string"
        ],
        "avgRating": "number",
        "totalRatings": "number",
        "orderCount": "number",
        "status": "enum (active | inactive | out_of_stock | discontinued)",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "subcollections": {
        "reviews": {
          "path": "products/{productId}/reviews/{reviewId}",
          "document_structure": {
            "reviewId": "string (auto-generated)",
            "userId": "string (ref: users/{userId})",
            "orderId": "string (ref: orders/{orderId})",
            "rating": "number (1-5)",
            "comment": "string",
            "imageURLs": [
              "string"
            ],
            "isVerified": "boolean",
            "helpfulCount": "number",
            "createdAt": "timestamp",
            "adminReply": {
              "message": "string",
              "repliedAt": "timestamp",
              "repliedBy": "string (ref: users/{userId})"
            }
          }
        },
        "inventory_movements": {
          "path": "products/{productId}/inventory_movements/{movementId}",
          "document_structure": {
            "movementId": "string (auto-generated)",
            "type": "enum (addition | sale | return | adjustment | damage)",
            "quantity": "number",
            "reason": "string",
            "orderId": "string (ref: orders/{orderId}, optional)",
            "doneBy": "string (ref: users/{userId})",
            "previousStock": "number",
            "newStock": "number",
            "createdAt": "timestamp"
          }
        }
      }
    },
    "categories": {
      "path": "categories/{categoryId}",
      "description": "Product categorization (Baskets, Accessories, etc.)",
      "document_structure": {
        "categoryId": "string (auto-generated)",
        "name": "string (e.g., 'Baskets', 'Accessories')",
        "description": "string",
        "imageURL": "string",
        "parentCategoryId": "string (ref: categories/{categoryId}, optional)",
        "sortOrder": "number",
        "isActive": "boolean",
        "productCount": "number",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "orders": {
      "path": "orders/{orderId}",
      "description": "Customer orders with shipping details and tracking",
      "document_structure": {
        "orderId": "string (auto-generated)",
        "orderNumber": "string (human-readable, e.g., 'HB2025001234')",
        "userId": "string (ref: users/{userId})",
        "status": "enum (pending | confirmed | processing | shipped | out_for_delivery | delivered | cancelled | returned | refunded)",
        "paymentStatus": "enum (pending | paid | failed | refunded)",
        "paymentMethod": "enum (UPI | card | cod | wallet | net_banking)",
        "subtotal": "number",
        "discount": "number",
        "shippingCharges": "number",
        "tax": {
          "cgst": "number",
          "sgst": "number",
          "igst": "number",
          "totalTax": "number"
        },
        "totalAmount": "number",
        "shippingAddress": {
          "addressId": "string",
          "line1": "string",
          "line2": "string",
          "landmark": "string",
          "city": "string",
          "state": "string",
          "pincode": "string",
          "contactName": "string",
          "contactPhone": "string"
        },
        "billingAddress": {
          "line1": "string",
          "line2": "string",
          "city": "string",
          "state": "string",
          "pincode": "string",
          "gstNumber": "string (optional)"
        },
        "shipping": {
          "provider": "string (e.g., 'BlueDart', 'Delhivery', 'DTDC')",
          "trackingNumber": "string",
          "trackingURL": "string",
          "estimatedDelivery": "timestamp",
          "actualDelivery": "timestamp",
          "shippedAt": "timestamp"
        },
        "deliveryInstructions": "string",
        "appliedCoupons": [
          {
            "couponId": "string",
            "code": "string",
            "discountAmount": "number"
          }
        ],
        "invoiceId": "string (ref: invoices/{invoiceId})",
        "invoiceURL": "string (Firebase Storage URL)",
        "createdAt": "timestamp",
        "updatedAt": "timestamp",
        "cancelledAt": "timestamp",
        "cancellationReason": "string",
        "refundAmount": "number"
      },
      "subcollections": {
        "order_items": {
          "path": "orders/{orderId}/order_items/{itemId}",
          "document_structure": {
            "itemId": "string (auto-generated)",
            "productId": "string (ref: products/{productId})",
            "sku": "string",
            "name": "string",
            "quantity": "number",
            "unitPrice": "number",
            "totalPrice": "number",
            "specifications": {
              "size": "string",
              "material": "string",
              "finish": "string"
            },
            "imageURL": "string",
            "tax": {
              "gstRate": "number",
              "taxAmount": "number"
            }
          }
        },
        "status_history": {
          "path": "orders/{orderId}/status_history/{statusId}",
          "document_structure": {
            "statusId": "string (auto-generated)",
            "status": "enum (pending | confirmed | processing | shipped | out_for_delivery | delivered | cancelled | returned)",
            "updatedBy": "enum (admin | system | logistics_partner | user)",
            "timestamp": "timestamp",
            "remarks": "string",
            "location": "string"
          }
        }
      }
