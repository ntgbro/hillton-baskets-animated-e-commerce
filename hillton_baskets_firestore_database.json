          "paidAt": "timestamp"
        },
        "invoiceDate": "timestamp",
        "dueDate": "timestamp",
        "pdfURL": "string (Firebase Storage URL)",
        "status": "enum (draft | issued | paid | cancelled)",
        "notes": "string",
        "termsAndConditions": "string",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
