{
  "metadata": {
    "name": "Hillton Baskets Complete Database Schema",
    "version": "1.0.0",
    "totalCollections": 33,
    "created": "2025-12-13",
    "description": "Complete e-commerce database with delivery, logging, staff, and financial management"
  },
