        "salarySlipURL": "string (PDF)",
        "processedBy": "string (ref: users)",
        "approvedBy": "string (ref: users)",
        "notes": "string",
        "createdAt": "timestamp"
      },
      "retention": "Forever (legal requirement)"
    },
