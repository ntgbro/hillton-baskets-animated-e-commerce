      "subcollections": {
        "addresses": "User shipping addresses",
        "cart": "Active shopping cart",
        "cart_items": "Items in cart (nested under cart)",
        "wishlist": "Wishlist items",
        "notifications": "User notifications"
      }
    },
    "products": {
      "purpose": "Product catalog",
      "schema": {
        "productId": "string",
        "sku": "string",
        "name": "string",
        "description": "string",
        "mainImageURL": "string",
        "galleryURLs": "array<string>",
        "category": "string (ref: categories)",
        "subCategory": "string",
        "specifications": "object",
        "price": "number",
        "discountedPrice": "number",
        "mrp": "number",
        "tax": {
          "gstRate": "number",
          "hsnCode": "string"
        },
        "inventory": {
          "currentStock": "number",
          "reorderLevel": "number",
          "maxStockLevel": "number"
        },
        "isAvailable": "boolean",
        "isFeatured": "boolean",
        "tags": "array<string>",
        "avgRating": "number",
        "totalRatings": "number",
        "orderCount": "number",
        "status": "enum (active | inactive | discontinued)",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "subcollections": {
        "reviews": "Product reviews (TO ADD)",
        "inventory_movements": "Stock movement history (TO ADD)"
      }
    },
    "categories": {
      "purpose": "Product categories hierarchy",
      "schema": {
        "categoryId": "string",
        "name": "string",
        "description": "string",
        "imageURL": "string",
        "parentCategoryId": "string (optional)",
        "sortOrder": "number",
        "isActive": "boolean",
        "productCount": "number",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "orders": {
      "purpose": "Customer orders",
      "schema": {
        "orderId": "string",
        "orderNumber": "string",
        "userId": "string (ref: users)",
        "status": "enum (pending | confirmed | processing | shipped | delivered | cancelled | returned)",
        "paymentStatus": "enum (pending | paid | failed | refunded)",
        "paymentMethod": "enum (UPI | card | netbanking | cod | wallet)",
        "subtotal": "number",
        "discount": "number",
        "shippingCharges": "number",
        "tax": {
          "cgst": "number",
          "sgst": "number",
          "totalTax": "number"
        },
        "totalAmount": "number",
        "shippingAddress": "object",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "subcollections": {
        "order_items": "Items in the order",
        "status_history": "Order status change history"
      }
    },
    "payments": {
      "purpose": "Payment transactions",
      "schema": {
        "paymentId": "string",
        "orderId": "string (ref: orders)",
        "userId": "string (ref: users)",
        "amount": "number",
        "method": "enum (UPI | card | netbanking | cod | wallet)",
        "provider": "enum (Razorpay | Paytm | PhonePe | COD)",
        "status": "enum (pending | processing | success | failed | refunded)",
        "gatewayTransactionId": "string",
        "gatewayResponse": "object",
        "timestamp": "timestamp",
        "fees": {
          "gatewayFee": "number",
          "platformFee": "number"
        }
      },
      "subcollections": {
        "refunds": "Refund transactions (TO ADD)"
      }
    },
    "invoices": {
      "purpose": "Order invoices",
      "schema": {
        "invoiceId": "string",
        "invoiceNumber": "string",
        "orderId": "string (ref: orders)",
        "userId": "string (ref: users)",
        "customerDetails": "object",
        "items": "array<object>",
        "amountBreakdown": "object",
        "paymentDetails": "object",
        "invoiceDate": "timestamp",
        "status": "enum (draft | paid | cancelled)",
        "createdAt": "timestamp"
      }
    },
    "warehouse": {
      "purpose": "Warehouse locations",
      "schema": {
        "warehouseId": "string",
        "name": "string",
        "code": "string",
        "address": "object",
        "contactPerson": "object",
        "isActive": "boolean",
        "isPrimary": "boolean",
        "totalProducts": "number",
        "createdAt": "timestamp"
      },
      "subcollections": {
        "inventory": "Product stock levels per warehouse",
        "stock_movements": "Stock movement tracking (TO ADD)"
      }
    },
    "cities": {
      "purpose": "Serviceable cities",
      "schema": {
        "cityId": "string",
        "name": "string",
        "state": "string",
        "country": "string",
        "isServiceable": "boolean",
        "currency": "string",
        "taxRate": {
          "cgst": "number",
          "sgst": "number"
        },
        "status": "enum (active | inactive)",
        "createdAt": "timestamp"
      },
      "subcollections": {
        "zones": "Delivery zones with pincodes"
      }
    },
    "coupons": {
      "purpose": "Discount coupons",
      "schema": {
        "couponId": "string",
        "code": "string",
        "title": "string",
        "description": "string",
        "type": "enum (percentage | fixed | free_shipping)",
        "discountValue": "number",
        "minOrderAmount": "number",
        "maxDiscountAmount": "number",
        "usageLimit": "object",
        "applicableFor": "object",
        "isActive": "boolean",
        "createdAt": "timestamp"
      }
    },
    "promotions": {
      "purpose": "Marketing promotions and banners",
      "schema": {
        "promotionId": "string",
        "title": "string",
        "description": "string",
        "bannerURL": "string",
        "promotionType": "enum (banner | flash_sale | seasonal | combo)",
        "startDate": "timestamp",
        "endDate": "timestamp",
        "isActive": "boolean",
        "targetAudience": "array<string>",
        "createdAt": "timestamp"
      }
    },
    "services": {
      "purpose": "Delivery and installation services",
      "schema": {
        "serviceId": "string",
        "name": "string",
        "description": "string",
        "type": "enum (delivery | installation | assembly)",
        "pricing": "object",
        "availability": "object",
        "isActive": "boolean",
        "createdAt": "timestamp"
      }
    },
    "chats": {
      "purpose": "Customer support live chats",
      "schema": {
        "chatId": "string",
        "userId": "string (ref: users)",
        "assignedTo": "string (ref: users - support agent)",
        "status": "enum (active | resolved | closed)",
        "subject": "string",
        "lastMessage": "string",
        "lastMessageAt": "timestamp",
        "unreadCount": "object",
        "priority": "enum (low | medium | high | urgent)",
        "tags": "array<string>",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "subcollections": {
        "messages": "Chat messages"
      }
    },
    "support_tickets": {
      "purpose": "Support tickets for registered users",
      "schema": {
        "ticketId": "string",
        "ticketNumber": "string",
        "userId": "string (ref: users)",
        "userEmail": "string",
        "userName": "string",
        "orderId": "string (optional)",
        "category": "enum (order_issue | product_inquiry | payment_issue | technical | other)",
        "priority": "enum (low | medium | high | critical)",
        "status": "enum (open | in_progress | resolved | closed)",
        "title": "string",
        "description": "string",
        "attachmentURLs": "array<string>",
        "assignedTo": "string (ref: users - support agent)",
        "resolution": "string",
        "rating": "number",
        "feedback": "string",
        "createdAt": "timestamp",
        "updatedAt": "timestamp",
        "resolvedAt": "timestamp"
      },
      "subcollections": {
        "messages": "Ticket conversation"
      }
    },
    "support_tickets_web": {
      "purpose": "Support tickets from guest users",
      "schema": {
        "ticketId": "string",
        "ticketNumber": "string",
        "guestEmail": "string",
        "guestName": "string",
        "guestPhone": "string",
        "orderNumber": "string (optional)",
        "category": "enum (product_inquiry | order_status | general | complaint)",
        "priority": "enum (low | medium | high)",
        "status": "enum (open | in_progress | resolved | closed)",
        "title": "string",
        "description": "string",
        "attachmentURLs": "array<string>",
        "assignedTo": "string",
        "resolution": "string",
        "ipAddress": "string",
        "userAgent": "string",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "subcollections": {
        "messages": "Ticket conversation"
      }
    },
    "admin_alerts": {
      "purpose": "System alerts for admins",
      "schema": {
        "alertId": "string",
        "title": "string",
        "message": "string",
        "type": "enum (low_stock | payment_failed | order_pending | system_error)",
        "severity": "enum (info | warning | error | critical)",
        "isRead": "boolean",
        "isResolved": "boolean",
        "relatedEntity": "object",
        "actionRequired": "boolean",
        "actionURL": "string",
        "assignedTo": "array<string>",
        "createdAt": "timestamp"
      }
    },
    "app_settings": {
      "purpose": "Application configuration",
      "documentId": "global_config",
      "schema": {
        "settingId": "string",
        "freeShippingThreshold": "number",
        "codAvailable": "boolean",
        "codCharges": "number",
        "maxCodAmount": "number",
        "defaultShippingCharges": "number",
        "taxRates": "object",
        "minOrderValue": "number",
        "updatedAt": "timestamp"
      }
    },
    "user_activity_logs": {
      "purpose": "Track user login/logout and session activity",
      "phase": "Phase 1 - Critical",
      "schema": {
        "logId": "string (auto)",
        "userId": "string (ref: users)",
        "userName": "string",
        "userEmail": "string",
        "userRole": "enum (customer | admin | support_agent | staff)",
        "activityType": "enum (login | logout | session_expired | password_reset | account_created)",
        "sessionId": "string",
        "deviceInfo": {
          "platform": "enum (web | android | ios)",
          "browser": "string",
          "deviceId": "string",
          "ipAddress": "string",
          "location": {
            "city": "string",
            "state": "string",
            "country": "string",
            "coordinates": "GeoPoint"
          }
        },
        "timestamp": "timestamp",
        "userAgent": "string"
      },
      "retention": "90 days"
    },
    "audit_logs": {
      "purpose": "Track all system changes (WHO did WHAT and WHEN)",
      "phase": "Phase 1 - Critical",
      "schema": {
        "logId": "string (auto)",
        "userId": "string (ref: users)",
        "userName": "string",
        "userRole": "enum (customer | admin | staff | support_agent)",
        "action": "enum (create | update | delete | view | approve | reject)",
        "entityType": "enum (product | order | user | payment | inventory | staff | salary)",
        "entityId": "string",
        "entityName": "string",
        "changes": {
          "before": "object",
          "after": "object"
        },
        "description": "string",
        "ipAddress": "string",
        "timestamp": "timestamp",
        "sessionId": "string"
      },
      "retention": "Forever (compliance)"
    },
    "staff_activity_logs": {
      "purpose": "Track staff attendance, tasks, and movements",
      "phase": "Phase 2 - Important",
      "schema": {
        "logId": "string (auto)",
        "staffId": "string (ref: staff)",
        "staffName": "string",
        "department": "enum (warehouse | production | sales | admin | support)",
        "activityType": "enum (check_in | check_out | break_start | break_end | task_assigned | task_completed | leave_applied)",
        "location": {
          "type": "enum (warehouse | office | remote)",
          "warehouseId": "string (optional)",
          "geoPoint": "GeoPoint"
        },
        "taskDetails": {
          "taskId": "string",
          "taskType": "string",
          "completionStatus": "enum (pending | completed | in_progress)"
        },
        "duration": "number (minutes)",
        "notes": "string",
        "timestamp": "timestamp",
        "approvedBy": "string (optional)"
      },
      "retention": "2 years"
    },
    "staff": {
      "purpose": "Employee master data",
      "phase": "Phase 1 - Critical",
      "schema": {
        "staffId": "string (auto)",
        "employeeCode": "string (e.g., EMP-2025-001)",
        "personalInfo": {
          "firstName": "string",
          "lastName": "string",
          "dateOfBirth": "timestamp",
          "gender": "enum (male | female | other)",
          "bloodGroup": "string",
          "photoURL": "string",
          "email": "string",
          "phone": "string",
          "alternatePhone": "string",
          "emergencyContact": {
            "name": "string",
            "relationship": "string",
            "phone": "string"
          }
        },
        "address": {
          "current": "object",
          "permanent": "object"
        },
        "employmentDetails": {
          "department": "enum (warehouse | production | sales | admin | support | accounts | hr)",
          "designation": "string",
          "role": "enum (staff | manager | supervisor | executive)",
          "joiningDate": "timestamp",
          "employmentType": "enum (full_time | part_time | contract | intern)",
          "workingHours": "object",
          "reportingTo": "string (ref: staff)",
          "assignedWarehouse": "string (optional)"
        },
        "salary": {
          "basic": "number",
          "hra": "number",
          "conveyance": "number",
          "otherAllowances": "number",
          "grossSalary": "number",
          "deductions": "object",
          "netSalary": "number",
          "paymentMode": "enum (bank_transfer | cash | cheque)",
          "bankDetails": "object",
          "lastIncrement": "object"
        },
        "documents": {
          "aadharCard": "string (URL)",
          "panCard": "string (URL)",
          "drivingLicense": "string (URL)",
          "educationCertificates": "array<string>",
          "experienceCertificates": "array<string>",
          "offerLetter": "string (URL)",
          "joiningLetter": "string (URL)"
        },
        "attendance": {
          "totalPresent": "number",
          "totalAbsent": "number",
          "totalLeaves": "number",
          "leavesRemaining": "object"
        },
        "performance": {
          "rating": "number (1-5)",
          "lastReviewDate": "timestamp",
          "strengths": "array<string>",
          "areasOfImprovement": "array<string>"
        },
        "status": "enum (active | on_leave | resigned | terminated)",
        "exitDetails": "object (optional)",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "subcollections": {
        "attendance": "Daily attendance records",
        "leaves": "Leave applications",
        "salary_slips": "Monthly salary slips",
        "performance_reviews": "Performance evaluations"
      }
    },
    "salary_payments": {
      "purpose": "Monthly salary disbursements",
